# ==============================================================================
# Saarthi AI Voice Pipeline — Environment Variables Template
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   cp .env.example .env

# Deepgram API Key (STT Nova-2 and TTS Aura Asteria)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API Key (Llama 3.1 8B Instant ultra-fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
